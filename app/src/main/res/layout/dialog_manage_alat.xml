<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="22dp"
                android:background="@color/campgear_green"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tv_dialog_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Form Kelola Alat"
                android:textColor="@color/campgear_green"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Image Upload Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#F2F9F4"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/iv_dialog_image_preview"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="#E8F5E9"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:contentDescription="Preview" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_dialog_pick_image"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="📷 Pilih / Ganti Gambar"
                    android:textAllCaps="false"
                    android:textColor="@color/campgear_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Label & Field: Nama Alat -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Nama Alat *"
            android:textColor="@color/campgear_green"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_dialog_nama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:hint="Contoh: Tenda Dome 4P"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="#212121"
            android:textColorHint="#888888"
            android:textSize="14sp" />

        <!-- Label & Field: Harga Sewa -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Harga Sewa (Rp / hari) *"
            android:textColor="@color/campgear_green"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_dialog_harga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:hint="Contoh: 50000"
            android:inputType="numberDecimal"
            android:padding="14dp"
            android:textColor="#212121"
            android:textColorHint="#888888"
            android:textSize="14sp" />

        <!-- Label & Field: ID Kategori -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="ID Kategori *"
            android:textColor="@color/campgear_green"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_dialog_kategori"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:hint="Contoh: 1 (Tenda) atau 2 (Tas)"
            android:inputType="number"
            android:padding="14dp"
            android:textColor="#212121"
            android:textColorHint="#888888"
            android:textSize="14sp" />

        <!-- Label & Field: Deskripsi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Deskripsi Alat"
            android:textColor="@color/campgear_green"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_dialog_deskripsi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_input_field"
            android:hint="Kapasitas, spesifikasi, atau keterangan tambahan..."
            android:inputType="textMultiLine"
            android:minLines="2"
            android:padding="14dp"
            android:textColor="#212121"
            android:textColorHint="#888888"
            android:textSize="14sp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_dialog_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_btn_red"
                android:text="Batal"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_dialog_save"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_login"
                android:text="Simpan"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
